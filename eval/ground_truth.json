{
  "_about": "Reference labels for the sample images, written from a manual review of each photo. To be confirmed by the client's safety SME. 'expected': hazards that must be found -- 'match' is a regex over title+description used to find the hazard, 'category' is the correct category per the tie-break rules. 'must_not': regexes for claims known to be false for that photo.",
  "images": {
    "Unshored data center trench work-1": {
      "expected": [
        {
          "id": "unshored trench",
          "match": "shor|shield|slop|cave",
          "category": "Excavation and Trenching"
        },
        {
          "id": "spoil pile at edge",
          "match": "spoil|excavated soil|soil pile|dirt pile",
          "category": "Excavation and Trenching"
        },
        {
          "id": "excavator near edge",
          "match": "excavator|heavy (equipment|machinery)",
          "category": "Heavy Equipment and Mobile Plant"
        },
        {
          "id": "no egress",
          "match": "egress|ladder|ramp|means of exit|exit",
          "category": "Access and Egress"
        }
      ],
      "must_not": []
    },
    "Data Center Mechanical Room Safety Hazards-2": {
      "expected": [
        {
          "id": "ladder overhead reach",
          "match": "ladder",
          "category": "Ladders and Stairways"
        }
      ],
      "must_not": [
        {
          "id": "eye/PPE guess",
          "match": "safety glasses|eye protection|without gloves|protective gloves"
        },
        {
          "id": "cylinder unsecured (it is chained)",
          "match": "cylinder.*(unsecured|not secured|not chained|without (a |any )?(visible )?(chain|strap)|without being (chained|secured))|(unsecured|not secured).*cylinder"
        }
      ]
    },
    "Data center construction safety hazards-3": {
      "expected": [
        {
          "id": "pedestrian near forklift",
          "match": "forklift",
          "category": "Heavy Equipment and Mobile Plant"
        },
        {
          "id": "worker on trailer cargo",
          "match": "trailer|flatbed|truck bed|cargo|truck",
          "category": "Working at Heights and Fall Protection"
        },
        {
          "id": "pipes on slope",
          "match": "pipe",
          "category": "Material Handling and Storage"
        },
        {
          "id": "straps on walkway",
          "match": "strap|band",
          "category": "Slips, Trips, and Falls"
        }
      ],
      "must_not": []
    },
    "Data center roof HVAC hazards-4": {
      "expected": [
